# ─── Large competition files — share via Google Drive instead ─────────────────
*.zip
*.pdf

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.env
.venv/
venv/
*.egg-info/
.DS_Store
.idea/
.vscode/

# ─── Real challenge data — never commit (too large; share via Google Drive) ───
data/train/*.tsv
data/test/*.tsv
!data/train/.gitkeep
!data/test/.gitkeep

# ─── Generated outputs — always regenerated by pipeline, never hand-edit ──────
output/*.tsv
!output/.gitkeep

# ─── Trained model artifacts ──────────────────────────────────────────────────
models/*
!models/.gitkeep
