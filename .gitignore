# ─── Dataset (too large for GitHub — share via Google Drive / OneDrive) ───────
*.zip
data/train/
data/test/
dataset/

# ─── Generated output (always regenerated by pipeline) ────────────────────────
output/matching_results.tsv
output/candidate_pairs.tsv

# ─── Trained models (usually large — add to Git LFS if needed) ───────────────
models/*.pkl
models/*.bin
models/*.joblib
models/*.pt
models/*.pth

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.env

# ─── Jupyter Notebooks checkpoints ───────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ─── OS / Editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ─── Experiment artifacts (keep the CSV log, ignore large dump files) ─────────
experiments/*.html
experiments/*.png
experiments/*.pkl
